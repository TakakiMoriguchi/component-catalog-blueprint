{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "react", "react-dom"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  // happydom.ts is only a bun test preload. The types entry of @testing-library/jest-dom is
  // not a module, so tsc cannot resolve it. It runs only at test time, so exclude it.
  "exclude": ["dist", "node_modules", "happydom.ts"]
}
