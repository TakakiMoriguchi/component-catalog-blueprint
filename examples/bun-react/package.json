{
  "name": "component-catalog-blueprint-example-bun-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "catalog": "BUN_PUBLIC_USE_CATALOG=true bun --hot src/index.ts",
    "test": "bun test --preload ./happydom.ts src/",
    "build": "NODE_ENV=production bun build ./src/index.html --outdir=dist --target=browser --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.4"
  }
}
